import cv2
import numpy as np
img = cv2.imread(r"C:\Users\SAIL\Documents\CV LAB\image.jpg")
if img is None:
    print("Error: Image not found!")
    exit()
gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (15, 15))
blackhat = cv2.morphologyEx(gray, cv2.MORPH_BLACKHAT, kernel)
cv2.imshow("Original Image", img)
cv2.imshow("Grayscale Image", gray)
cv2.imshow("Black Hat Result", blackhat)
cv2.imwrite(r"C:\Users\SAIL\Documents\CV LAB\blackhat_result.jpg", blackhat)
print("Black Hat result saved successfully!")
cv2.waitKey(0)
cv2.destroyAllWindows()
