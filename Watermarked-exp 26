import cv2
image = cv2.imread("image.jpg")
if image is None:
    print("Error: Unable to load image.")
    exit()
watermarked = image.copy()
cv2.putText(watermarked, "WATERMARK", (50, 50), cv2.FONT_HERSHEY_SIMPLEX, 2, (0, 255, 0), 3)
cv2.imwrite("watermarked_output.jpg", watermarked)
cv2.imshow("Original Image", image)
cv2.imshow("Watermarked Image", watermarked)
cv2.waitKey(0)
cv2.destroyAllWindows()
print("Output saved as 'watermarked_output.jpg'")
