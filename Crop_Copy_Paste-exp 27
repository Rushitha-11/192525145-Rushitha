import cv2
from tkinter import filedialog
from tkinter import Tk
Tk().withdraw()
img1_path = filedialog.askopenfilename(title="Select destination image")
img2_path = filedialog.askopenfilename(title="Select image to crop")
image1 = cv2.imread(img1_path)
image2 = cv2.imread(img2_path)
if image1 is None or image2 is None:
    print("Error: Unable to load images.")
    exit()
cropped = image2[50:200, 50:200]
image1[50:200, 50:200] = cropped
cv2.imwrite("cropped_pasted_output.jpg", image1)
cv2.imshow("Cropped and Pasted Image", image1)
cv2.waitKey(0)
cv2.destroyAllWindows()
print("Output saved as 'cropped_pasted_output.jpg'")
