import cv2
img = cv2.imread("image.jfif")
if img is None:
    print("Error: Image not found.")
    exit()
height, width = img.shape[:2]
center = (width // 2, height // 2)
clockwise_matrix = cv2.getRotationMatrix2D(center, -45, 1)
clockwise = cv2.warpAffine(img, clockwise_matrix, (width, height))
counter_matrix = cv2.getRotationMatrix2D(center, 45, 1)
counter_clockwise = cv2.warpAffine(img, counter_matrix, (width, height))
cv2.imshow("Original Image", img)
cv2.imshow("Clockwise Rotation", clockwise)
cv2.imshow("Counter Clockwise Rotation", counter_clockwise)
cv2.imwrite("clockwise_image.jpg", clockwise)
cv2.imwrite("counter_clockwise_image.jpg", counter_clockwise)
print("Image rotation completed successfully.")
print("Saved: clockwise_image.jpg and counter_clockwise_image.jpg")
cv2.waitKey(0)
cv2.destroyAllWindows()
