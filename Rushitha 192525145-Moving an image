import cv2
import numpy as np
img = cv2.imread("image.jfif")
if img is None:
    print("Error: Image not found.")
    exit()
height, width = img.shape[:2]
translation_matrix = np.float32([
    [1, 0, 100],
    [0, 1, 50]
])
moved_image = cv2.warpAffine(img, translation_matrix, (width, height))
cv2.imshow("Original Image", img)
cv2.imshow("Moved Image", moved_image)
cv2.imwrite("moved_image.jpg", moved_image)
print("Image movement completed successfully.")
print("Saved as moved_image.jpg")
cv2.waitKey(0)
cv2.destroyAllWindows()
